  parent                 HandlingUnit?         @relation("HandlingUnitNesting", fields: [parentId], references: [id], onDelete: Restrict)
  children               HandlingUnit[]        @relation("HandlingUnitNesting")
  currentHub             LogisticsHub?         @relation(fields: [currentHubId], references: [id], onDelete: Restrict)
  contents               HandlingUnitContent[]
  events                 HandlingEvent[]
  consolidationLoads     ConsolidationLoad[]
  postalReceptacle       PostalReceptacle?

  @@unique([tenantId, sscc])
  @@unique([tenantId, externalIdentifier])
  @@index([tenantId, type, status, currentHubId])
}

model HandlingUnitContent {
  id             String       @id @db.Char(36)
  tenantId       String       @db.Char(36)
  handlingUnitId String       @db.Char(36)
  cargoItemId    String       @db.Char(36)
  packageCount   Int
  weightGrams    BigInt
  volumeCubicCm  BigInt?
  handlingUnit   HandlingUnit @relation(fields: [handlingUnitId], references: [id], onDelete: Restrict)

  @@unique([tenantId, handlingUnitId, cargoItemId])
  @@index([tenantId, cargoItemId])
}

model HandlingEvent {
  id             String        @id @db.Char(36)
  tenantId       String        @db.Char(36)
  handlingUnitId String        @db.Char(36)
  hubId          String?       @db.Char(36)
  type           String        @db.VarChar(80)
  condition      String?       @db.VarChar(40)
  locationText   String?       @db.VarChar(240)
  occurredAt     DateTime      @db.DateTime(3)
  source         String        @db.VarChar(40)
  externalKey    String        @db.VarChar(160)
  data           Json?
  recordedBy     String        @db.Char(36)
  createdAt      DateTime      @default(now()) @db.DateTime(3)
  handlingUnit   HandlingUnit  @relation(fields: [handlingUnitId], references: [id], onDelete: Restrict)
  hub            LogisticsHub? @relation(fields: [hubId], references: [id], onDelete: Restrict)

  @@unique([tenantId, handlingUnitId, externalKey])
  @@index([tenantId, hubId, occurredAt])
}

model ConsolidationPlan {
  id                  String                            @id @db.Char(36)
  tenantId            String                            @db.Char(36)
  number              String                            @db.VarChar(80)
  status              String                            @default("DRAFT") @db.VarChar(40)
  mode                String                            @db.VarChar(20)
  serviceLevel        String?                           @db.VarChar(40)
  originHubId         String                            @db.Char(36)
  destinationHubId    String                            @db.Char(36)
  cutoffAt            DateTime                          @db.DateTime(3)
  plannedDepartureAt  DateTime                          @db.DateTime(3)
  plannedArrivalAt    DateTime                          @db.DateTime(3)
  maxWeightGrams      BigInt?
  maxVolumeCubicCm    BigInt?
  equipmentType       String?                           @db.VarChar(60)
  masterReference     String?                           @db.VarChar(120)
  sealNumber          String?                           @db.VarChar(80)
  route               Json?
  version             Int                               @default(1)
  createdBy           String                            @db.Char(36)
  closedAt            DateTime?                         @db.DateTime(3)
  departedAt          DateTime?                         @db.DateTime(3)
  arrivedAt           DateTime?                         @db.DateTime(3)
  deconsolidatedAt    DateTime?                         @db.DateTime(3)
  completedAt         DateTime?                         @db.DateTime(3)
  createdAt           DateTime                          @default(now()) @db.DateTime(3)
  updatedAt           DateTime                          @updatedAt @db.DateTime(3)
  originHub           LogisticsHub                      @relation("PlanOriginHub", fields: [originHubId], references: [id], onDelete: Restrict)
  destinationHub      LogisticsHub                      @relation("PlanDestinationHub", fields: [destinationHubId], references: [id], onDelete: Restrict)
  members             ConsolidationMember[]
  loads               ConsolidationLoad[]
  linehaulAllocations InternationalLinehaulAllocation[]

  @@unique([tenantId, number])
  @@index([tenantId, status, cutoffAt, plannedDepartureAt])
}

model ConsolidationMember {
  id                     String                @id @db.Char(36)
  tenantId               String                @db.Char(36)
  planId                 String                @db.Char(36)
  bookingId              String                @db.Char(36)
  consignmentId          String?               @db.Char(36)
  status                 String                @default("ALLOCATED") @db.VarChar(40)
  allocatedWeightGrams   BigInt
  allocatedVolumeCubicCm BigInt?
  packageCount           Int
  loadingPriority        Int                   @default(100)
  finalDestination       String?               @db.VarChar(240)
  addedAt                DateTime              @default(now()) @db.DateTime(3)
  unloadedAt             DateTime?             @db.DateTime(3)
  plan                   ConsolidationPlan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  consignment            TransportConsignment? @relation(fields: [consignmentId], references: [id], onDelete: Restrict)

  @@unique([tenantId, planId, bookingId])
  @@index([tenantId, bookingId, status])
}

model ConsolidationLoad {
  id             String            @id @db.Char(36)
  tenantId       String            @db.Char(36)
  planId         String            @db.Char(36)
  handlingUnitId String            @db.Char(36)
  loadSequence   Int
  position       String?           @db.VarChar(80)
  status         String            @default("PLANNED") @db.VarChar(40)
  loadedAt       DateTime?         @db.DateTime(3)
  unloadedAt     DateTime?         @db.DateTime(3)
  plan           ConsolidationPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  handlingUnit   HandlingUnit      @relation(fields: [handlingUnitId], references: [id], onDelete: Restrict)

  @@unique([tenantId, planId, handlingUnitId])
  @@unique([tenantId, planId, loadSequence])
}

model InternationalLinehaul {
  id                    String                            @id @db.Char(36)
  tenantId              String                            @db.Char(36)
  number                String                            @db.VarChar(80)
  status                String                            @default("SCHEDULED") @db.VarChar(40)
  mode                  String                            @db.VarChar(20)
  originLocationId      String                            @db.Char(36)
  destinationLocationId String                            @db.Char(36)
  carrierId             String?                           @db.Char(36)
  conveyanceReference   String?                           @db.VarChar(120)
  equipmentIdentifier   String?                           @db.VarChar(120)
  scheduledDepartureAt  DateTime                          @db.DateTime(3)
  scheduledArrivalAt    DateTime                          @db.DateTime(3)
  actualDepartureAt     DateTime?                         @db.DateTime(3)
  actualArrivalAt       DateTime?                         @db.DateTime(3)
  maxWeightGrams        BigInt?
  maxVolumeCubicCm      BigInt?
  route                 Json?
  version               Int                               @default(1)
  createdBy             String                            @db.Char(36)
  createdAt             DateTime                          @default(now()) @db.DateTime(3)
  updatedAt             DateTime                          @updatedAt @db.DateTime(3)
  originLocation        StandardLocation                  @relation("LinehaulOrigin", fields: [originLocationId], references: [id], onDelete: Restrict)
  destinationLocation   StandardLocation                  @relation("LinehaulDestination", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  allocations           InternationalLinehaulAllocation[]

  @@unique([tenantId, number])
  @@index([tenantId, mode, status, scheduledDepartureAt])
}

model InternationalLinehaulAllocation {
  id                     String                @id @db.Char(36)
  tenantId               String                @db.Char(36)
  linehaulId             String                @db.Char(36)
  consolidationPlanId    String                @db.Char(36)
  allocatedWeightGrams   BigInt
  allocatedVolumeCubicCm BigInt?
  status                 String                @default("BOOKED") @db.VarChar(40)
  linehaul               InternationalLinehaul @relation(fields: [linehaulId], references: [id], onDelete: Restrict)
  consolidationPlan      ConsolidationPlan     @relation(fields: [consolidationPlanId], references: [id], onDelete: Restrict)

  @@unique([tenantId, linehaulId, consolidationPlanId])
}

model PostalOperator {
  id           String              @id @db.Char(36)
  tenantId     String              @db.Char(36)
  code         String              @db.VarChar(20)
  name         String              @db.VarChar(200)
  countryCode  String              @db.Char(2)
  designated   Boolean             @default(false)
  identifiers  Json?
  status       String              @default("ACTIVE") @db.VarChar(40)
  createdAt    DateTime            @default(now()) @db.DateTime(3)
  updatedAt    DateTime            @updatedAt @db.DateTime(3)
  products     PostalProduct[]
  items        PostalItem[]
  receptacles  PostalReceptacle[]
  dispatches   PostalDispatch[]
  consignments PostalConsignment[]

  @@unique([tenantId, code])
  @@index([tenantId, countryCode, status])
}

model PostalProduct {
  id                String         @id @db.Char(36)
  tenantId          String         @db.Char(36)
  operatorId        String         @db.Char(36)
  code              String         @db.VarChar(40)
  name              String         @db.VarChar(160)
  category          String         @db.VarChar(40)
  tracked           Boolean        @default(true)
  registered        Boolean        @default(false)
  insured           Boolean        @default(false)
  signatureRequired Boolean        @default(false)
  customsRequired   Boolean        @default(false)
  maxWeightGrams    BigInt?
  maxDimensions     Json?
  serviceStandard   Json?
  status            String         @default("ACTIVE") @db.VarChar(40)
  operator          PostalOperator @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  items             PostalItem[]

  @@unique([tenantId, operatorId, code])
}

model PostalItem {
  id                     String                 @id @db.Char(36)
  tenantId               String                 @db.Char(36)
  operatorId             String                 @db.Char(36)
  productId              String                 @db.Char(36)
  customerId             String                 @db.Char(36)
  s10Identifier          String                 @db.Char(13)
  status                 String                 @default("ACCEPTED") @db.VarChar(40)
  originCountryCode      String                 @db.Char(2)
  destinationCountryCode String                 @db.Char(2)
  sender                 Json
  recipient              Json
  contentDescription     String                 @db.VarChar(1000)
  weightGrams            BigInt
  dimensions             Json?
  declaredValueMinor     BigInt                 @default(0)
  currency               String                 @db.Char(3)
  customsData            Json?
  postageMinor           BigInt                 @default(0)
  version                Int                    @default(1)
  acceptedAt             DateTime               @default(now()) @db.DateTime(3)
  deliveredAt            DateTime?              @db.DateTime(3)
  createdAt              DateTime               @default(now()) @db.DateTime(3)
  updatedAt              DateTime               @updatedAt @db.DateTime(3)
  operator               PostalOperator         @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  product                PostalProduct          @relation(fields: [productId], references: [id], onDelete: Restrict)
  receptacleLinks        PostalReceptacleItem[]
  events                 PostalEvent[]

  @@unique([tenantId, s10Identifier])
  @@index([tenantId, customerId, status, createdAt])
}

model PostalReceptacle {
  id                  String                        @id @db.Char(36)
  tenantId            String                        @db.Char(36)
  operatorId          String                        @db.Char(36)
  handlingUnitId      String?                       @unique @db.Char(36)
  receptacleId        String                        @db.VarChar(35)
  type                String                        @db.VarChar(40)
  mailCategory        String                        @db.VarChar(40)
  originImpcCode      String                        @db.Char(6)
  destinationImpcCode String                        @db.Char(6)
  status              String                        @default("OPEN") @db.VarChar(40)
  sealNumber          String?                       @db.VarChar(80)
  grossWeightGrams    BigInt?
  closedAt            DateTime?                     @db.DateTime(3)
  openedAt            DateTime?                     @db.DateTime(3)
  version             Int                           @default(1)
  createdAt           DateTime                      @default(now()) @db.DateTime(3)
  operator            PostalOperator                @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  handlingUnit        HandlingUnit?                 @relation(fields: [handlingUnitId], references: [id], onDelete: Restrict)
  itemLinks           PostalReceptacleItem[]
  dispatchLinks       PostalDispatchReceptacle[]
  consignmentLinks    PostalConsignmentReceptacle[]
  events              PostalEvent[]

  @@unique([tenantId, receptacleId])
  @@index([tenantId, originImpcCode, destinationImpcCode, status])
}

model PostalReceptacleItem {
  id           String           @id @db.Char(36)
  tenantId     String           @db.Char(36)
  receptacleId String           @db.Char(36)
  itemId       String           @db.Char(36)
  loadedAt     DateTime         @default(now()) @db.DateTime(3)
  unloadedAt   DateTime?        @db.DateTime(3)
  receptacle   PostalReceptacle @relation(fields: [receptacleId], references: [id], onDelete: Restrict)
  item         PostalItem       @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([tenantId, receptacleId, itemId])
  @@index([tenantId, itemId])
}

model PostalDispatch {
  id                   String                     @id @db.Char(36)
  tenantId             String                     @db.Char(36)
  operatorId           String                     @db.Char(36)
  dispatchId           String                     @db.VarChar(35)
  status               String                     @default("OPEN") @db.VarChar(40)
  originImpcCode       String                     @db.Char(6)
  destinationImpcCode  String                     @db.Char(6)
  mailCategory         String                     @db.VarChar(40)
  dispatchNumber       Int
  scheduledDepartureAt DateTime?                  @db.DateTime(3)
  closedAt             DateTime?                  @db.DateTime(3)
  handedOverAt         DateTime?                  @db.DateTime(3)
  receivedAt           DateTime?                  @db.DateTime(3)
  version              Int                        @default(1)
  createdAt            DateTime                   @default(now()) @db.DateTime(3)
  updatedAt            DateTime                   @updatedAt @db.DateTime(3)
  operator             PostalOperator             @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  receptacleLinks      PostalDispatchReceptacle[]
  events               PostalEvent[]

  @@unique([tenantId, dispatchId])
  @@unique([tenantId, originImpcCode, destinationImpcCode, mailCategory, dispatchNumber])
  @@index([tenantId, status, scheduledDepartureAt])
}

model PostalDispatchReceptacle {
  id           String           @id @db.Char(36)
  tenantId     String           @db.Char(36)
  dispatchId   String           @db.Char(36)
  receptacleId String           @db.Char(36)
  sequence     Int
  dispatch     PostalDispatch   @relation(fields: [dispatchId], references: [id], onDelete: Restrict)
  receptacle   PostalReceptacle @relation(fields: [receptacleId], references: [id], onDelete: Restrict)

  @@unique([tenantId, dispatchId, receptacleId])
  @@unique([tenantId, dispatchId, sequence])
}

model PostalConsignment {
  id                   String                        @id @db.Char(36)
  tenantId             String                        @db.Char(36)
  operatorId           String                        @db.Char(36)
  consignmentId        String                        @db.VarChar(12)
  status               String                        @default("PLANNED") @db.VarChar(40)
  carrierId            String?                       @db.Char(36)
  transportReference   String?                       @db.VarChar(120)
  originImpcCode       String                        @db.Char(6)
  destinationImpcCode  String                        @db.Char(6)
  scheduledDepartureAt DateTime?                     @db.DateTime(3)
  scheduledArrivalAt   DateTime?                     @db.DateTime(3)
  handedOverAt         DateTime?                     @db.DateTime(3)
  receivedAt           DateTime?                     @db.DateTime(3)
  createdAt            DateTime                      @default(now()) @db.DateTime(3)
  operator             PostalOperator                @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  receptacleLinks      PostalConsignmentReceptacle[]

  @@unique([tenantId, consignmentId])
  @@index([tenantId, status, scheduledDepartureAt])
}

model PostalConsignmentReceptacle {
  id            String            @id @db.Char(36)
  tenantId      String            @db.Char(36)
  consignmentId String            @db.Char(36)
  receptacleId  String            @db.Char(36)
  sequence      Int
  consignment   PostalConsignment @relation(fields: [consignmentId], references: [id], onDelete: Restrict)
  receptacle    PostalReceptacle  @relation(fields: [receptacleId], references: [id], onDelete: Restrict)

  @@unique([tenantId, consignmentId, receptacleId])
  @@unique([tenantId, consignmentId, sequence])
}

model PostalEvent {
  id           String            @id @db.Char(36)
  tenantId     String            @db.Char(36)
  itemId       String?           @db.Char(36)
  receptacleId String?           @db.Char(36)
  dispatchId   String?           @db.Char(36)
  standard     String            @db.VarChar(40)
  code         String            @db.VarChar(20)
  description  String            @db.VarChar(500)
  locationCode String?           @db.VarChar(40)
  occurredAt   DateTime          @db.DateTime(3)
  source       String            @db.VarChar(40)
  externalKey  String            @db.VarChar(160)
  data         Json?
  recordedBy   String?           @db.Char(36)
  createdAt    DateTime          @default(now()) @db.DateTime(3)
  item         PostalItem?       @relation(fields: [itemId], references: [id], onDelete: Restrict)
  receptacle   PostalReceptacle? @relation(fields: [receptacleId], references: [id], onDelete: Restrict)
  dispatch     PostalDispatch?   @relation(fields: [dispatchId], references: [id], onDelete: Restrict)

  @@unique([tenantId, standard, externalKey])
  @@index([tenantId, itemId, occurredAt])
  @@index([tenantId, receptacleId, occurredAt])
  @@index([tenantId, dispatchId, occurredAt])
}
