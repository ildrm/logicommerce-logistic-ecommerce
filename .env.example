NODE_ENV=development
WEB_PORT=3000
API_PORT=3001
PUBLIC_BASE_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
DATABASE_URL=mysql://logicommerce:logicommerce_local@mysql:3306/logicommerce
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_USER=logicommerce
DATABASE_PASSWORD=logicommerce_local
DATABASE_NAME=logicommerce
MYSQL_ROOT_PASSWORD=local_root_only
REDIS_URL=redis://redis:6379
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=logicommerce-local
S3_ACCESS_KEY=logicommerce
S3_SECRET_KEY=logicommerce_local_storage
SMTP_HOST=mailpit
SMTP_PORT=1025
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_PEPPER=replace-with-a-different-32-character-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
FIELD_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_REFRESH_RATE_LIMIT_MAX=30
AUTH_RECOVERY_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
CORS_ORIGINS=http://localhost:8080,http://localhost:3000
PAYMENT_ADAPTER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
COINBASE_API_KEY_ID=
COINBASE_API_KEY_SECRET=
COINBASE_WEBHOOK_SECRET=
TAX_ADAPTER=mock
CARRIER_ADAPTER=mock
LOG_LEVEL=info
OTEL_ENABLED=false
RATE_LIMIT_MAX=120
SEED_DEMO_DATA=true
