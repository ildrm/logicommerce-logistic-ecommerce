# Compose-rendering example only. The application rejects these placeholders at startup.
DATABASE_NAME=logicommerce
DATABASE_USER=logicommerce
DATABASE_PASSWORD=change-me-database-password
MYSQL_ROOT_PASSWORD=change-me-mysql-root-password
DATABASE_URL=mysql://logicommerce:change-me-database-password@mysql:3306/logicommerce
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=change-me-access-secret-with-at-least-48-unique-random-characters
JWT_REFRESH_PEPPER=change-me-refresh-pepper-with-at-least-48-unique-random-characters
FIELD_ENCRYPTION_KEY=change-me-field-key-with-at-least-48-unique-random-characters
CORS_ORIGINS=https://app.example.com
PUBLIC_BASE_URL=https://app.example.com
NEXT_PUBLIC_API_URL=https://app.example.com/api/v1
PAYMENT_ADAPTER=stripe
STRIPE_SECRET_KEY=change-me-stripe-key
STRIPE_WEBHOOK_SECRET=change-me-stripe-webhook-secret
COMMERCE_ADAPTER=http
COMMERCE_PROVIDER_URL=https://commerce-provider.example.com
COMMERCE_PROVIDER_TOKEN=change-me-commerce-provider-token
CARRIER_ADAPTER=http
CARRIER_PROVIDER_URL=https://carrier-provider.example.com
CARRIER_PROVIDER_TOKEN=change-me-carrier-provider-token
IDENTITY_VERIFICATION_ADAPTER=http
IDENTITY_VERIFICATION_URL=https://identity-provider.example.com
IDENTITY_VERIFICATION_TOKEN=change-me-identity-provider-token
C2C_PAYMENT_ADAPTER=http
C2C_PAYMENT_PROVIDER_URL=https://escrow-provider.example.com
C2C_PAYMENT_PROVIDER_TOKEN=change-me-escrow-provider-token
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://objects.example.com
S3_ACCESS_KEY=change-me-object-storage-user
S3_SECRET_KEY=change-me-object-storage-secret-with-at-least-48-unique-random-characters
DOCUMENT_SCANNER_ADAPTER=http
DOCUMENT_SCANNER_URL=https://document-scanner.example.com
DOCUMENT_SCANNER_TOKEN=change-me-document-scanner-token
EMAIL_ADAPTER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=change-me-smtp-user
SMTP_PASSWORD=change-me-smtp-password
SMTP_FROM=no-reply@example.com
PARTNER_WEBHOOK_ALLOWED_HOSTS=partner-a.example.com,partner-b.example.com
