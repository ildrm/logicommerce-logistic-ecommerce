{
  "name": "logicommerce-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.15.1 <12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "pnpm --filter @logicommerce/api exec vitest run src --coverage.enabled --coverage.provider=v8 --coverage.reporter=text --coverage.reporter=json-summary --coverage.reportsDirectory=coverage --coverage.include=src/**/*.ts --coverage.thresholds.lines=10 --coverage.thresholds.statements=9 --coverage.thresholds.branches=8 --coverage.thresholds.functions=7",
    "test:e2e": "playwright test",
    "test:auth:live": "node tests/e2e/authentication-live.mjs",
    "test:commerce:live": "node tests/e2e/commerce-live.mjs",
    "test:network:live": "node tests/e2e/network-phases-live.mjs",
    "test:phase8-11:live": "node tests/e2e/phase8-11-live.mjs",
    "test:phase12:live": "node tests/e2e/phase12-live.mjs",
    "test:phase13:live": "node tests/e2e/phase13-live.mjs",
    "test:load": "k6 run tests/performance/control-plane.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @logicommerce/database prisma:generate",
    "db:migrate": "pnpm --filter @logicommerce/database prisma:migrate",
    "db:deploy": "pnpm --filter @logicommerce/database prisma:deploy",
    "db:seed": "pnpm --filter @logicommerce/database db:seed"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.61.1",
    "@vitest/coverage-v8": "4.1.10",
    "@types/node": "24.10.1",
    "eslint": "9.39.2",
    "prettier": "3.7.4",
    "turbo": "2.5.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.52.0",
    "vitest": "4.1.10"
  }
}
