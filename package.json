{
  "name": "logicommerce-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.15.1 <12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @logicommerce/database prisma:generate",
    "db:migrate": "pnpm --filter @logicommerce/database prisma:migrate",
    "db:deploy": "pnpm --filter @logicommerce/database prisma:deploy",
    "db:seed": "pnpm --filter @logicommerce/database db:seed"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.61.1",
    "@types/node": "24.10.1",
    "eslint": "9.39.2",
    "prettier": "3.7.4",
    "turbo": "2.5.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.52.0",
    "vitest": "4.1.10"
  }
}
